# Lucas — Web (apps/web)
# Copia este archivo a .env.local. En Vercel: Project → Settings → Environment Variables.
#
# Todas las variables de este archivo son PÚBLICAS (NEXT_PUBLIC_*): terminan en
# el navegador y está bien que así sea. La seguridad la dan las políticas RLS.

# URL del proyecto Supabase. PÚBLICA.
#   Supabase Dashboard → Project Settings → Data API → Project URL
#   En local (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave publicable (antes «anon key»). PÚBLICA por diseño.
#   Supabase Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_…)
#   En local: la «Publishable key» que imprime `supabase start`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Dominio público de la app, sin «/» al final. PÚBLICA. Opcional.
# Se usa para armar los links de invitación (…/e/PASEO-7K2Q). Si no está,
# se toma del request (sirve en local y en los previews de Vercel).
#   Producción: https://tu-dominio.co
NEXT_PUBLIC_SITE_URL=

# NUNCA pongas aquí la service role key ni la secret key (sb_secret_…): esas
# solo viven en services/connector y services/worker (ver sus .env.example).
