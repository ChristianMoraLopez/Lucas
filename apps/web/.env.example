# Lucas — Web (apps/web)
#
# Variables PÚBLICAS (se exponen al navegador, es seguro):
# URL del proyecto Supabase. Se obtiene en:
#   Supabase Dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública ("publishable key", antes llamada anon key). Es pública por diseño:
# la seguridad la dan las políticas RLS, no el secreto de esta llave. Se obtiene en:
#   Supabase Dashboard → Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
#
# NUNCA pongas aquí la service role key: esa solo vive en services/connector y
# services/worker (ver sus propios .env.example).
