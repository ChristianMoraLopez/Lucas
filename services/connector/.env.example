# Luks — Connector de WhatsApp (services/connector)
#
# Copia este archivo a .env en el servidor. Las marcadas SECRETO jamás van a
# Vercel, al navegador ni al repositorio.

# ── Supabase ────────────────────────────────────────────────────────────────
# URL del proyecto: Supabase Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# SECRETO MÁXIMO (salta RLS). La «secret key» (sb_secret_…) o la service_role
# antigua (eyJ…): Project Settings → API Keys → Secret keys. La misma del worker.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# SECRETO. 32 bytes en base64 para cifrar las credenciales de WhatsApp antes de
# guardarlas en Postgres (AES-256-GCM). Genérala UNA vez y guárdala: si la
# cambias o la pierdes, hay que volver a vincular todos los números.
#   openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# ── Sentry (opcional) ───────────────────────────────────────────────────────
# DSN del proyecto (Sentry → Settings → Projects → lucas-connector → Client Keys).
# Avisa, entre otras cosas, cuando se cierra la sesión del número contador.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Confirmaciones en el grupo ──────────────────────────────────────────────
# «Anotado: Asadero El Llanero · $272.500 · pagó Mafe». Cada grupo las puede
# apagar desde la web; esto las apaga para todos.
GROUP_REPLIES=true
# Mínimo entre dos mensajes de Luks en el mismo grupo y topes por hora.
# Escribir mucho y seguido es la forma más rápida de que WhatsApp bloquee el número.
REPLY_MIN_INTERVAL_S=20
REPLY_MAX_PER_HOUR_GROUP=20
REPLY_MAX_PER_HOUR=60
# Cuántos gastos caben en un mismo mensaje de confirmación
REPLY_BATCH_MAX=5

# ── Archivos ────────────────────────────────────────────────────────────────
# No baja nada más pesado que esto; el bucket «evidencias» acepta hasta 6 MB.
MEDIA_MAX_DOWNLOAD_MB=25
MEDIA_MAX_UPLOAD_MB=6
# Las fotos se guardan en JPEG con este lado máximo, como las que sube la web
IMAGE_MAX_SIDE=1600
IMAGE_QUALITY=80

# ── Operación ───────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# HEALTH_PORT=8080          # /health, /health/cola y /health/vivo (solo dentro de Docker)
# SYNC_INTERVAL_S=5         # cada cuánto mira si la web pidió vincular o desvincular
# QUEUE_STALE_AFTER_S=900   # /health/cola falla si un trabajo lleva más que esto esperando
