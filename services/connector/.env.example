# Lucas — Connector de WhatsApp (services/connector)
#
# TODAS estas variables son SECRETAS. Este servicio corre en tu servidor
# (Oracle Cloud Always Free o PC propio), jamás en Vercel ni en el navegador.

# URL del proyecto Supabase:
#   Supabase Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key (SECRETO MÁXIMO: bypass de RLS). Se obtiene en:
#   Supabase Dashboard → Project Settings → API Keys → Service role key
# Solo connector y worker pueden usarla. Jamás en la web.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Clave de 32 bytes (base64) para cifrar las credenciales de sesión de Baileys
# antes de guardarlas en Postgres (whatsapp_connections.session_ciphertext).
# Genérala con: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# URL pública del proyecto Sentry para reporte de errores (DSN). Se obtiene en:
#   Sentry → Settings → Projects → lucas-connector → Client Keys (DSN)
SENTRY_DSN=
