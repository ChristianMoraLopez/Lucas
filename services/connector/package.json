{
  "name": "@lucas/connector",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Lucas · connector de WhatsApp: sesiones de Baileys, enlace de grupos e ingesta de gastos",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "^11.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "baileys": "7.0.0-rc14",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
