# Lucas — Worker de procesamiento (services/worker)
#
# TODAS estas variables son SECRETAS. Este servicio corre en tu servidor
# junto a Ollama, jamás en Vercel ni en el navegador.

# URL del proyecto Supabase:
#   Supabase Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key (SECRETO MÁXIMO: bypass de RLS). Se obtiene en:
#   Supabase Dashboard → Project Settings → API Keys → Service role key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# URL del servidor Ollama local (corre en la misma máquina por Docker Compose)
OLLAMA_BASE_URL=http://ollama:11434

# Modelo de Ollama usado para estructurar recibos en JSON
OLLAMA_MODEL=qwen2.5:7b

# Repositorio privado de Hugging Face donde viven los modelos Laya ajustados.
# El token es de solo lectura. Se obtiene en: https://huggingface.co/settings/tokens
HF_REPO=tu-usuario/lucas-laya
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# DSN de Sentry para reporte de errores:
#   Sentry → Settings → Projects → lucas-worker → Client Keys (DSN)
SENTRY_DSN=
