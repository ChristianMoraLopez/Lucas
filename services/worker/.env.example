# Lucas — Worker de procesamiento (services/worker)
#
# Copia este archivo a .env en el servidor (Oracle Cloud ARM) junto a
# docker-compose.yml. Las marcadas SECRETO jamás van a Vercel ni al navegador.

# ── Supabase ────────────────────────────────────────────────────────────────
# URL del proyecto:
#   Supabase Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# SECRETO MÁXIMO (salta RLS). La «secret key» nueva (sb_secret_…) o la
# service_role antigua (eyJ…), las dos sirven:
#   Supabase Dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Ollama (corre en la misma máquina, por Docker Compose) ──────────────────
OLLAMA_BASE_URL=http://ollama:11434
# qwen2.5:7b lee mejor; qwen2.5:3b es ~2x más rápido en CPU. Si lo cambias,
# `docker compose up -d` vuelve a correr ollama-pull y lo baja.
OLLAMA_MODEL=qwen2.5:7b
# Segundos que se le espera a una respuesta (en CPU un recibo largo toma 1–2 min)
OLLAMA_TIMEOUT_S=300
# LLM_ENABLED=false  # para probar solo con reglas, OCR y QR

# ── Laya (clasificación) ────────────────────────────────────────────────────
# multilingual: lee el texto en español · english: lee la descripción en inglés
LAYA_VARIANT=multilingual
# Repositorio PRIVADO de Hugging Face donde el notebook sube los modelos
# (carpetas multilingual/ y english/). Sin esto, el worker clasifica con la
# memoria de comercios y palabras clave.
HF_REPO=tu-usuario/lucas-laya
# SECRETO. Token de SOLO LECTURA: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# O una carpeta local con la variante (en vez de HF_REPO):
# LAYA_MODEL_DIR=/models/laya-local
# Techo de confianza para un Laya sin ajustar (zero-shot): así va a revisión
LAYA_ZERO_SHOT_MAX_CONFIDENCE=0.8

# ── Reglas ──────────────────────────────────────────────────────────────────
# Confianza mínima en todos los campos para confirmar solo (y solo si la
# categoría salió de la memoria de comercios)
AUTO_CONFIRM_MIN=0.9
# Bits distintos (de 256) para decir que dos fotos son la misma
DEDUP_HASH_MAX_DISTANCE=12

# ── Sentry ──────────────────────────────────────────────────────────────────
# DSN del proyecto (no es secreto, pero no lo publiques):
#   Sentry → Settings → Projects → lucas-worker → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0 = solo errores; 0.2 = también tiempos de 1 de cada 5 trabajos
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Operación ───────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# POLL_INTERVAL_S=3          # cada cuánto mira la cola cuando está vacía
# STALE_AFTER_MINUTES=15     # un trabajo tomado sin terminar se rescata después de esto
# OCR_THREADS=0              # 0 = todos los núcleos
