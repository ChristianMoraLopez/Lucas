# Lucas — Supabase local (supabase start)
# Copia este archivo a supabase/.env. La CLI reemplaza env(...) de config.toml
# con estos valores. Solo hace falta si quieres probar Google en local.
#
# En producción NO se usa este archivo: Google se configura en el Dashboard
# (Authentication → Sign In / Providers → Google). Ver README.

# ID de cliente OAuth. PÚBLICO (aparece en la URL de Google).
#   Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth 2.0 (Aplicación web)
#   URI de redirección autorizada para local: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=

# Secreto del cliente OAuth. SECRETO.
#   Mismo lugar que el ID de cliente.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
