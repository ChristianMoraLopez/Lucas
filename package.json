{
  "name": "lucas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "pnpm --filter @lucas/db test",
    "db:push": "supabase db push",
    "worker:test": "cd services/worker && uv run pytest",
    "worker:lint": "cd services/worker && uv run ruff check . && uv run ruff format --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.5.0"
  }
}
